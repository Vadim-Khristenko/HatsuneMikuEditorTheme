{
  "name": "hatsune-miku-themes",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "vsc"
  ],
  "scripts": {
    "check": "bun tools/palette/build.ts --check && node tools/check-themes.mjs && bun tools/release/release.ts check && bun test tools",
    "validate": "bun tools/validate.ts",
    "package:vsc": "bun tools/package.ts vsc",
    "package:zed": "bun tools/package.ts zed",
    "package:jetbrains": "bun tools/package.ts jetbrains",
    "package:neovim": "bun tools/package.ts neovim",
    "package:sublime": "bun tools/package.ts sublime",
    "package:notepadpp": "bun tools/package.ts notepadpp",
    "package:telegram": "bun tools/package.ts telegram",
    "package:browser": "bun tools/package.ts browser",
    "package:all": "bun tools/package.ts all",
    "build:browser": "bun browser/build.ts",
    "build:telegram": "bun tools/telegram/build.ts",
    "sync:telegram": "bun tools/telegram/sync-keys.ts",
    "test:browser": "bun test browser",
    "typecheck:browser": "tsc -p browser/tsconfig.json",
    "test:telegram": "bun test tools/telegram",
    "typecheck:telegram": "tsc -p tools/telegram/tsconfig.json",
    "release:plan": "bun tools/release/release.ts plan",
    "release:prepare": "bun tools/release/release.ts prepare",
    "build:palette": "bun tools/palette/build.ts",
    "package:spicetify": "bun tools/package.ts spicetify",
    "typecheck:palette": "tsc -p tools/palette/tsconfig.json"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "^1.4.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "archiver": "5.3.1"
  }
}
