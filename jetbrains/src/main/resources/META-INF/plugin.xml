<idea-plugin>
  <id>com.github.vadimkhristenko.hatsunemikutheme</id>
  <name>Hatsune Miku Theme</name>
  <version>0.1.0</version>
  <vendor url="https://github.com/Vadim-Khristenko/HatsuneMikuEditorTheme" email="vadim@vai-rice.space">Vadim Khristenko</vendor>
  <idea-version since-build="231" until-build="262.*"/>
  <description><![CDATA[
    Hatsune Miku color themes (Miku Dark/Light, Sakura Dark/Light) for
    IntelliJ Platform IDEs. Inspired by Hatsune Miku.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="hatsunemiku.dark" path="/themes/hatsuneMikuDark.theme.json"/>
    <themeProvider id="hatsunemiku.light" path="/themes/hatsuneMikuLight.theme.json"/>
    <themeProvider id="hatsunemiku.sakuradark" path="/themes/hatsuneMikuSakuraDark.theme.json"/>
    <themeProvider id="hatsunemiku.sakuralight" path="/themes/hatsuneMikuSakuraLight.theme.json"/>
  </extensions>
</idea-plugin>
