  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a49c9c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#2c2424"
      }
    },
    {
      "name": "Variable - Built-in",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c13c51"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#263848"
      }
    },
    {
      "name": "Variable - Member",
      "scope": [
        "variable.other.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6d4e32"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Keyword - Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#0050c3"
      }
    },
    {
      "name": "Keyword - Return",
      "scope": [
        "keyword.control.return",
        "keyword.control.flow"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#d40040"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#52807e"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Tag - Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8e1cc9"
      }
    },
    {
      "name": "HTML Attribute",
      "scope": [
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c24e00"
      }
    },
    {
      "name": "Function, Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c13c51"
      }
    },
    {
      "name": "Function - Built-in",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
