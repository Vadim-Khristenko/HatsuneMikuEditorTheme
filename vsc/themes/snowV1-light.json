  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#94a0ad"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#1a2836"
      }
    },
    {
      "name": "Variable - Built-in",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e3005e"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#343a14"
      }
    },
    {
      "name": "Variable - Member",
      "scope": [
        "variable.other.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#524e7f"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Keyword - Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#0050c3"
      }
    },
    {
      "name": "Keyword - Return",
      "scope": [
        "keyword.control.return",
        "keyword.control.flow"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#d40040"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#52817f"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "Tag - Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8e1cc9"
      }
    },
    {
      "name": "HTML Attribute",
      "scope": [
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c44e00"
      }
    },
    {
      "name": "Function, Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#05598b"
      }
    },
    {
      "name": "Function - Built-in",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#008271"
      }
    },
    {
      "name": "Function - Decorator",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c44e00"
      }
    },
    {
      "name": "Number, Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#8e1cc9"
      }
    },
    {
      "name": "String",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#c44e00"
      }
    },
    {
      "name": "String - Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d40040"
      }
    },
    {
      "name": "String - Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#05598b"
      }
    },
    {
      "name": "String - Symbol",
      "scope": [
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#05598b"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name",
        "support.class"
      ],
      "settings": {
        "foreground": "#c44e00"
      }
    },
    {
      "name": "Type",
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#0050c3"
      }
    },
    {
      "name": "Type - Built-in",
      "scope": [
        "support.type.builtin"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#0050c3"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#524e7f"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name"
      ],
      "settings": {
        "foreground": "#524e7f"
      }
    },
    {
      "name": "CSS Class",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#c44e00"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#05598b"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#0050c3"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8e1cc9"
      }
    },
    {
      "name": "Markup - Link",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#05598b"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    }
  ]
}
