  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#635857"
      }
    },
    {
      "name": "Comment Doc",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#786e6d"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#eedddb"
      }
    },
    {
      "name": "Variable - Built-in",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#da646a"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e2ad81"
      }
    },
    {
      "name": "Variable - Member / Property",
      "scope": [
        "variable.other.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#97b2fb"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6d89"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff6d89"
      }
    },
    {
      "name": "Keyword - Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ff6d89"
