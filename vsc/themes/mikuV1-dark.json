  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a5280"
      }
    },
    {
      "name": "Comment Doc",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5a6490"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ccd6f6"
      }
    },
    {
      "name": "Variable - Built-in",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff708e"
      }
