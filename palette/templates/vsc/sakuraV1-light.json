  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c088a0"
      }
    },
    {
      "name": "Comment Doc",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a87090"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#3a1428"
      }
    },
    {
      "name": "Variable - Built-in",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ee3366"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6a3020"
      }
    },
    {
      "name": "Variable - Member",
      "scope": [
        "variable.other.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#7a2244"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc2244"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cc2244"
      }
    },
    {
      "name": "Keyword - Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2244aa"
      }
    },
    {
      "name": "Keyword - Return",
      "scope": [
        "keyword.control.return",
        "keyword.control.flow"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#cc2244"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#a87090"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#cc2244"
      }
    },
    {
      "name": "Tag - Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cc4477"
      }
    },
    {
      "name": "HTML Attribute",
      "scope": [
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#996600"
      }
    },
    {
      "name": "Function, Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#227766"
      }
    },
    {
      "name": "Function - Built-in",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#339988"
      }
    },
    {
      "name": "Function - Decorator",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#996600"
      }
    },
    {
